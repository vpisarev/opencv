# ----------------------------------------------------------------------------
#  Fast compiler probes
#
#  OpenCV configure runs a few hundred compiler feature checks. Each one that goes
#  through try_compile() configures and builds a nested CMake project (80-200 ms
#  even for an empty source file, 1-2 s with the Xcode generator), while the
#  compiler itself needs 15-40 ms. This module runs the same checks by invoking
#  the compiler directly, with a command line composed from the same variables
#  CMake uses for try_compile(), and keeps the exact result variable names and
#  values, so every consumer (including unmodified 3rdparty CMake code and
#  pre-seeded caches passed with `cmake -C`) keeps working.
#
#  Safety: the fast path is used only when all three levels agree, otherwise
#  the unchanged try_compile() path is taken:
#    1. static whitelist (ocv_probe_init): GCC/Clang-style drivers only
#       (GNU, Clang, AppleClang, IntelLLVM on UNIX), no Visual Studio generator,
#       all implicit toolchain flags (target, sysroot, OSX sysroot/arch/deployment
#       target) must be expressible; cross-compiling toolchains (Android NDK,
#       iOS, Emscripten, Linux cross) are supported for compile-only probes;
#    2. runtime self-test (ocv_probe_selftest): the composed command must compile
#       a trivial source, accept a known-good flag, name two known-bad flags in
#       its diagnostics, agree with reference try_compile() results, and its
#       preprocessor must report the pointer size CMake detected;
#    3. per probe: link-level probes while cross-compiling, probes whose
#       arguments cannot be expressed on a plain command line, or outputs that
#       cannot be parsed deterministically fall back for that probe only.
#
#  Controls:
#    OPENCV_FAST_COMPILER_PROBES=OFF (or env OPENCV_SKIP_FAST_COMPILER_PROBES=1)
#        disable the fast path entirely;
#    OPENCV_VERIFY_FAST_PROBES=ON|STRICT
#        run both paths for every probe and report mismatches (STRICT: fatal);
#    OPENCV_PROBE_VERBOSE=ON
#        print the composed command for every probe.
#  Full log of every direct compiler invocation: <build>/CMakeFiles/OpenCVProbe.log
#
#  Batched flag checks: plain options (no code generation, no linking, no custom
#  source, no -Werror in effect) are probed together, one -fsyntax-only run per
#  language, and the compiler's diagnostics are attributed to the offending
#  options ("unknown warning option '-Wfoo'" etc). The known option list lives
#  in OpenCVCompilerProbeSeeds.cmake; ocv_warnings_disable() batches its own
#  arguments. A batch whose diagnostics cannot all be attributed is discarded
#  and every option is probed individually.
#
#  try_compile() interception (OPENCV_FAST_TRY_COMPILE, see
#  ocv_probe_enable_try_compile_interception): the try_compile() command itself
#  is overridden, so the checks of CMake's own modules (check_include_file,
#  check_symbol_exists, check_type_size, check_*_source_compiles,
#  check_function_exists, FindThreads, ...) and of unmodified 3rdparty/contrib
#  CMake code are served by a direct compiler run when the call is simple
#  (plain source files of one language, CMAKE_FLAGS limited to definitions,
#  include/link directories, libraries, flags and language standard). Checks
#  about declarations only (CheckIncludeFile*, CheckSymbolExists, CheckTypeSize)
#  are compiled, everything else is compiled and linked, as try_compile() does.
#  Every other call (project signature, CMake targets as libraries, unknown
#  CMAKE_FLAGS, other languages, link-level checks when the direct link line
#  failed the self-test) goes to the original command, available as _try_compile.
# ----------------------------------------------------------------------------

set(OPENCV_PROBE_FORMAT_VERSION 1)
set(OPENCV_PROBE_DIR "${CMAKE_BINARY_DIR}/CMakeFiles/OpenCVProbe")
set(OPENCV_PROBE_LOG "${CMAKE_BINARY_DIR}/CMakeFiles/OpenCVProbe.log")

# Diagnostics that name an unsupported flag. The first capture group that is not a
# quote character holds the flag (or a `-Wfoo=` prefix). Quotes: ASCII and the
# UTF-8 typographic quotes GCC uses outside the C locale.
set(OCV_PROBE_REJECTED_FLAG_REGEX
    "unknown warning option ['‘\"]([^'’\"]+)['’\"]"            # Clang (warning, or error with -Werror)
    "unknown argument: ['‘\"]([^'’\"]+)['’\"]"                  # Clang driver
    "unsupported option ['‘\"]([^'’\"]+)['’\"]"                 # Clang driver
    "unrecognized command[- ]line option ['‘\"]([^'’\"]+)['’\"]" # GCC driver error, cc1plus note for -Wno-*
    "unrecognized argument in option ['‘\"]([^'’\"]+)['’\"]"    # GCC: -march=foo
    "command[- ]line option ['‘\"]([^'’\"]+)['’\"] is valid for" # GCC: C-only flag passed to C++
    "argument to ['‘\"]([^'’\"]+)['’\"] is not valid"           # GCC: -Wfoo=<bad value>
    "ignoring unknown option ['‘\"]([^'’\"]+)['’\"]"            # MSVC D9002
)

# Options that change the link line or need code generation: never -fsyntax-only, never batched.
set(OCV_PROBE_LINK_FLAGS_REGEX "-(pthread|pg|flto|fprofile[-a-z]*|fsanitize|static|fuse-ld|rdynamic|fstack-protector[-a-z]*|-coverage|coverage)")
set(OCV_PROBE_CODEGEN_FLAGS_REGEX "-(m|x|O)")
# Options never batched for other reasons: -Werror changes the test source, -g/-D/-U/-I/-L/-l
# and linker pass-through are never "unsupported" in a way worth batching.
set(OCV_PROBE_UNBATCHABLE_FLAGS_REGEX "-(Werror|g|D|U|I|L|l|Wl,|Xlinker|Xclang|shared|nostdlib|nodefaultlibs|arch|isysroot|target|std=)")

include("${CMAKE_CURRENT_LIST_DIR}/OpenCVCompilerProbeSeeds.cmake")

function(ocv_probe_log text)
  file(APPEND "${OPENCV_PROBE_LOG}" "${text}\n")
endfunction()

# Remember a cache variable produced by the fast path, so that it can be
# invalidated when the compiler/toolchain configuration changes.
function(ocv_probe_record var)
  set(__list "${OPENCV_PROBE_RESULT_VARS}")
  if("${var}" IN_LIST __list)
    return()
  endif()
  list(APPEND __list "${var}")
  set(OPENCV_PROBE_RESULT_VARS "${__list}" CACHE INTERNAL "Cache variables produced by fast compiler probes")
endfunction()

function(ocv_probe_compute_cache_key outvar)
  set(__key "format=${OPENCV_PROBE_FORMAT_VERSION}")
  foreach(v
      CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_C_COMPILER_ARG1 CMAKE_CXX_COMPILER_ARG1
      CMAKE_C_COMPILER_ID CMAKE_CXX_COMPILER_ID CMAKE_C_COMPILER_VERSION CMAKE_CXX_COMPILER_VERSION
      CMAKE_C_SIMULATE_ID CMAKE_CXX_SIMULATE_ID
      CMAKE_BUILD_TYPE CMAKE_CONFIGURATION_TYPES CMAKE_CXX_STANDARD CMAKE_CXX_EXTENSIONS
      CMAKE_OSX_SYSROOT CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET
      CMAKE_SYSROOT CMAKE_SYSROOT_COMPILE CMAKE_C_COMPILER_TARGET CMAKE_CXX_COMPILER_TARGET
      CMAKE_C_COMPILER_EXTERNAL_TOOLCHAIN CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN
      CMAKE_TRY_COMPILE_TARGET_TYPE CMAKE_GENERATOR CMAKE_CROSSCOMPILING CMAKE_TOOLCHAIN_FILE
      CMAKE_SYSTEM_NAME CMAKE_SYSTEM_PROCESSOR
      OPENCV_FAST_COMPILER_PROBES OPENCV_VERIFY_FAST_PROBES)
    set(__key "${__key};${v}=${${v}}")
  endforeach()
  foreach(v CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_EXE_LINKER_FLAGS)
    get_property(__cv CACHE ${v} PROPERTY VALUE)
    set(__key "${__key};${v}=${__cv}")
  endforeach()
  string(SHA1 __key "${__key}")
  set(${outvar} "${__key}" PARENT_SCOPE)
endfunction()

# Once per configure: truncate the log; if the toolchain configuration changed
# since the cached results were produced, drop them.
function(ocv_probe_check_cache_key)
  get_property(__done GLOBAL PROPERTY OCV_PROBE_CACHE_KEY_CHECKED)
  if(__done)
    return()
  endif()
  set_property(GLOBAL PROPERTY OCV_PROBE_CACHE_KEY_CHECKED 1)
  file(MAKE_DIRECTORY "${OPENCV_PROBE_DIR}")
  string(TIMESTAMP __now)
  file(WRITE "${OPENCV_PROBE_LOG}" "# OpenCV fast compiler probes log (${__now})\n")
  ocv_probe_compute_cache_key(__key)
  if(NOT "${OPENCV_PROBE_CACHE_KEY}" STREQUAL "${__key}")
    if(DEFINED OPENCV_PROBE_CACHE_KEY)
      message(STATUS "OpenCV: compiler/toolchain configuration changed, re-running compiler probes")
      foreach(v ${OPENCV_PROBE_RESULT_VARS})
        unset(${v} CACHE)
      endforeach()
    endif()
    foreach(lang C CXX)
      unset(OPENCV_FAST_PROBE_AVAILABLE_${lang} CACHE)
      unset(OPENCV_FAST_PROBE_REASON_${lang} CACHE)
      unset(OPENCV_PROBE_BASE_COMMAND_${lang} CACHE)
    endforeach()
    set(OPENCV_PROBE_RESULT_VARS "" CACHE INTERNAL "Cache variables produced by fast compiler probes")
    set(OPENCV_PROBE_CACHE_KEY "${__key}" CACHE INTERNAL "Toolchain fingerprint of the cached compiler probe results")
  endif()
endfunction()

# Compose the part of the compiler command line that does not depend on the
# current CMAKE_<LANG>_FLAGS: compiler, target, sysroot, Apple SDK/arch/deployment target.
# Sets ${outvar} to the list, or to "" with ${reasonvar} explaining why it cannot be composed.
function(ocv_probe_compiler_base_command lang outvar reasonvar)
  set(${outvar} "" PARENT_SCOPE)
  set(__cmd "${CMAKE_${lang}_COMPILER}")
  if(CMAKE_${lang}_COMPILER_ARG1)
    separate_arguments(__arg1 NATIVE_COMMAND "${CMAKE_${lang}_COMPILER_ARG1}")
    list(APPEND __cmd ${__arg1})
  endif()
  if(CMAKE_${lang}_COMPILER_TARGET)
    if(NOT CMAKE_${lang}_COMPILE_OPTIONS_TARGET)
      set(${reasonvar} "CMAKE_${lang}_COMPILER_TARGET is set but CMAKE_${lang}_COMPILE_OPTIONS_TARGET is not" PARENT_SCOPE)
      return()
    endif()
    list(APPEND __cmd "${CMAKE_${lang}_COMPILE_OPTIONS_TARGET}${CMAKE_${lang}_COMPILER_TARGET}")
  endif()
  if(CMAKE_${lang}_COMPILER_EXTERNAL_TOOLCHAIN)
    if(NOT CMAKE_${lang}_COMPILE_OPTIONS_EXTERNAL_TOOLCHAIN)
      set(${reasonvar} "CMAKE_${lang}_COMPILER_EXTERNAL_TOOLCHAIN is set but CMAKE_${lang}_COMPILE_OPTIONS_EXTERNAL_TOOLCHAIN is not" PARENT_SCOPE)
      return()
    endif()
    list(APPEND __cmd "${CMAKE_${lang}_COMPILE_OPTIONS_EXTERNAL_TOOLCHAIN}${CMAKE_${lang}_COMPILER_EXTERNAL_TOOLCHAIN}")
  endif()
  set(__sysroot "${CMAKE_SYSROOT_COMPILE}")
  if(NOT __sysroot)
    set(__sysroot "${CMAKE_SYSROOT}")
  endif()
  if(__sysroot)
    if(NOT CMAKE_${lang}_COMPILE_OPTIONS_SYSROOT)
      set(${reasonvar} "CMAKE_SYSROOT is set but CMAKE_${lang}_COMPILE_OPTIONS_SYSROOT is not" PARENT_SCOPE)
      return()
    endif()
    list(APPEND __cmd "${CMAKE_${lang}_COMPILE_OPTIONS_SYSROOT}${__sysroot}")
  endif()
  if(APPLE OR CMAKE_SYSTEM_NAME MATCHES "^(Darwin|iOS|tvOS|watchOS|visionOS)$")
    if(CMAKE_OSX_SYSROOT)
      set(__sdk "")
      if(IS_DIRECTORY "${CMAKE_OSX_SYSROOT}")
        set(__sdk "${CMAKE_OSX_SYSROOT}")
      elseif(_CMAKE_OSX_SYSROOT_PATH AND IS_DIRECTORY "${_CMAKE_OSX_SYSROOT_PATH}")
        set(__sdk "${_CMAKE_OSX_SYSROOT_PATH}")
      else()
        execute_process(COMMAND xcrun --sdk "${CMAKE_OSX_SYSROOT}" --show-sdk-path
                        OUTPUT_VARIABLE __sdk ERROR_QUIET RESULT_VARIABLE __rc OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT __rc EQUAL 0 OR NOT IS_DIRECTORY "${__sdk}")
          set(${reasonvar} "cannot resolve CMAKE_OSX_SYSROOT='${CMAKE_OSX_SYSROOT}' to an SDK path" PARENT_SCOPE)
          return()
        endif()
      endif()
      set(__sysroot_flag "${CMAKE_${lang}_SYSROOT_FLAG}")
      if(NOT __sysroot_flag)
        set(__sysroot_flag "-isysroot")
      endif()
      list(APPEND __cmd "${__sysroot_flag}" "${__sdk}")
    endif()
    if(CMAKE_OSX_DEPLOYMENT_TARGET)
      set(__dt_flag "${CMAKE_${lang}_OSX_DEPLOYMENT_TARGET_FLAG}")
      if(NOT __dt_flag OR __dt_flag MATCHES "<")
        set(${reasonvar} "cannot express CMAKE_OSX_DEPLOYMENT_TARGET with CMAKE_${lang}_OSX_DEPLOYMENT_TARGET_FLAG='${__dt_flag}'" PARENT_SCOPE)
        return()
      endif()
      list(APPEND __cmd "${__dt_flag}${CMAKE_OSX_DEPLOYMENT_TARGET}")
    endif()
    set(__archs "${CMAKE_TRY_COMPILE_OSX_ARCHITECTURES}")
    if(NOT __archs)
      set(__archs "${CMAKE_OSX_ARCHITECTURES}")
    endif()
    foreach(__arch ${__archs})
      list(APPEND __cmd "-arch" "${__arch}")
    endforeach()
  endif()
  set(${outvar} "${__cmd}" PARENT_SCOPE)
endfunction()

# Run the compiler directly.
#   ocv_probe_run(<lang> <SYNTAX|OBJECT|LINK|PREPROCESS> <source> <rc-var> <output-var>
#                 [FLAGS ...] [INCLUDE_DIRS ...] [LINK_DIRS ...] [LINK_LIBRARIES ...])
# Sets <rc-var> to the exit code (or "NOTRUN" when the command cannot be composed)
# and <output-var> to stdout+stderr (PREPROCESS: stdout only).
function(ocv_probe_run lang mode src rcvar outvar)
  cmake_parse_arguments(P "" "" "FLAGS;INCLUDE_DIRS;LINK_DIRS;LINK_LIBRARIES" ${ARGN})
  set(${rcvar} "NOTRUN" PARENT_SCOPE)
  set(${outvar} "" PARENT_SCOPE)
  set(__cmd "${OPENCV_PROBE_BASE_COMMAND_${lang}}")
  if(NOT __cmd)
    return()
  endif()
  # Order mirrors CMake's compile line: <DEFINES=probe flags> <FLAGS> <std> <mode> <source>
  foreach(__f ${P_FLAGS})
    separate_arguments(__fa NATIVE_COMMAND "${__f}")
    list(APPEND __cmd ${__fa})
  endforeach()
  foreach(__d ${P_INCLUDE_DIRS})
    list(APPEND __cmd "-I${__d}")
  endforeach()
  separate_arguments(__flags NATIVE_COMMAND "${CMAKE_${lang}_FLAGS}")
  list(APPEND __cmd ${__flags})
  set(__cfg "${CMAKE_TRY_COMPILE_CONFIGURATION}")
  if(NOT __cfg)
    set(__cfg "${CMAKE_BUILD_TYPE}")
  endif()
  if(NOT __cfg AND CMAKE_CONFIGURATION_TYPES)
    set(__cfg "DEBUG")  # try_compile() builds the Debug configuration by default
  endif()
  if(__cfg)
    string(TOUPPER "${__cfg}" __cfg)
    separate_arguments(__flags NATIVE_COMMAND "${CMAKE_${lang}_FLAGS_${__cfg}}")
    list(APPEND __cmd ${__flags})
  endif()
  if(DEFINED CMAKE_${lang}_STANDARD AND CMAKE_${lang}_STANDARD)
    if(DEFINED CMAKE_${lang}_EXTENSIONS AND NOT CMAKE_${lang}_EXTENSIONS)
      set(__std_opt "${CMAKE_${lang}${CMAKE_${lang}_STANDARD}_STANDARD_COMPILE_OPTION}")
    else()
      set(__std_opt "${CMAKE_${lang}${CMAKE_${lang}_STANDARD}_EXTENSION_COMPILE_OPTION}")
    endif()
    list(APPEND __cmd ${__std_opt})
  endif()
  if(CMAKE_${lang}_COMPILER_ID STREQUAL "GNU")
    list(APPEND __cmd -fdiagnostics-color=never -fmax-errors=0)
  else()
    list(APPEND __cmd -fno-color-diagnostics -ferror-limit=0)
  endif()
  get_property(__n GLOBAL PROPERTY OCV_PROBE_COUNTER)
  if(NOT __n)
    set(__n 0)
  endif()
  math(EXPR __n "${__n} + 1")
  set_property(GLOBAL PROPERTY OCV_PROBE_COUNTER ${__n})
  set(__merge_streams 1)
  if(mode STREQUAL "SYNTAX")
    list(APPEND __cmd -fsyntax-only "${src}")
  elseif(mode STREQUAL "OBJECT")
    list(APPEND __cmd -c "${src}" -o "${OPENCV_PROBE_DIR}/probe_${__n}.o")
  elseif(mode STREQUAL "LINK")
    list(APPEND __cmd ${src} -o "${OPENCV_PROBE_DIR}/probe_${__n}.exe")  # ${src} may be a list
    # <CMAKE_<LANG>_LINK_FLAGS> of the link rule (Darwin: -Wl,-search_paths_first ...), then the user flags
    separate_arguments(__lflags NATIVE_COMMAND "${CMAKE_${lang}_LINK_FLAGS}")
    list(APPEND __cmd ${__lflags})
    separate_arguments(__lflags NATIVE_COMMAND "${CMAKE_EXE_LINKER_FLAGS}")
    list(APPEND __cmd ${__lflags})
    if(__cfg)
      separate_arguments(__lflags NATIVE_COMMAND "${CMAKE_EXE_LINKER_FLAGS_${__cfg}}")
      list(APPEND __cmd ${__lflags})
    endif()
    foreach(__d ${P_LINK_DIRS})
      list(APPEND __cmd "-L${__d}")
    endforeach()
    foreach(__lib ${P_LINK_LIBRARIES})
      if(TARGET "${__lib}")
        ocv_probe_log("# cannot link against CMake target '${__lib}' directly, probe not run")
        return()
      elseif(__lib MATCHES "^(.+)/([^/]+)\\.framework/?$")
        list(APPEND __cmd "-F${CMAKE_MATCH_1}" -framework "${CMAKE_MATCH_2}")
      elseif(__lib MATCHES "^-" OR IS_ABSOLUTE "${__lib}")
        separate_arguments(__la NATIVE_COMMAND "${__lib}")
        list(APPEND __cmd ${__la})
      else()
        list(APPEND __cmd "-l${__lib}")
      endif()
    endforeach()
    separate_arguments(__stdlibs NATIVE_COMMAND "${CMAKE_${lang}_STANDARD_LIBRARIES}")  # Android: -latomic -lm
    list(APPEND __cmd ${__stdlibs})
  elseif(mode STREQUAL "PREPROCESS")
    if(lang STREQUAL "CXX")
      list(APPEND __cmd -x c++)
    else()
      list(APPEND __cmd -x c)
    endif()
    list(APPEND __cmd -E -P "${src}")
    set(__merge_streams 0)
  else()
    message(FATAL_ERROR "ocv_probe_run: unknown mode '${mode}'")
  endif()
  if(OPENCV_PROBE_VERBOSE)
    message(STATUS "probe[${__n}]: ${__cmd}")
  endif()
  set(__env LC_ALL=C LANG=C LC_MESSAGES=C)
  if(CMAKE_GENERATOR STREQUAL "Xcode")
    # xcodebuild takes the deployment target from the project (CMAKE_OSX_DEPLOYMENT_TARGET,
    # handled above) and does not pass these environment variables to the compiler, while
    # clang invoked directly would honour them (platforms/ios/build_framework.py exports
    # IPHONEOS_DEPLOYMENT_TARGET). Hide them so that the results match try_compile().
    foreach(__v IPHONEOS MACOSX TVOS WATCHOS XROS DRIVERKIT)
      list(APPEND __env "--unset=${__v}_DEPLOYMENT_TARGET")
    endforeach()
  endif()
  if(__merge_streams)
    execute_process(COMMAND ${CMAKE_COMMAND} -E env ${__env} ${__cmd}
                    WORKING_DIRECTORY "${OPENCV_PROBE_DIR}"
                    RESULT_VARIABLE __rc OUTPUT_VARIABLE __out ERROR_VARIABLE __out TIMEOUT 120)
  else()
    execute_process(COMMAND ${CMAKE_COMMAND} -E env ${__env} ${__cmd}
                    WORKING_DIRECTORY "${OPENCV_PROBE_DIR}"
                    RESULT_VARIABLE __rc OUTPUT_VARIABLE __out ERROR_VARIABLE __err TIMEOUT 120)
  endif()
  string(REPLACE ";" " " __cmd_str "${__cmd}")
  ocv_probe_log("\n=== probe ${__n} (${lang} ${mode}) rc=${__rc}\n${__cmd_str}\n--- output:\n${__out}${__err}--- end")
  set(${rcvar} "${__rc}" PARENT_SCOPE)
  set(${outvar} "${__out}" PARENT_SCOPE)
endfunction()

# Does the compiler output contain a line matching OCV_COMPILER_FAIL_REGEX? -> ${outvar} = 1/0
function(ocv_probe_output_has_failure output outvar)
  set(${outvar} 0 PARENT_SCOPE)
  string(REPLACE ";" "," __lines "${output}")
  string(REPLACE "\n" ";" __lines "${__lines}")
  foreach(__regex ${OCV_COMPILER_FAIL_REGEX})
    foreach(__line ${__lines})
      if("${__line}" MATCHES "${__regex}")
        set(${outvar} 1 PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endforeach()
endfunction()

# Flags named in "unknown/unrecognized option" diagnostics -> ${outvar} (list).
function(ocv_probe_parse_rejected_flags output outvar)
  set(__found "")
  string(REPLACE ";" "," __lines "${output}")
  string(REPLACE "\n" ";" __lines "${__lines}")
  foreach(__line ${__lines})
    foreach(__regex ${OCV_PROBE_REJECTED_FLAG_REGEX})
      if("${__line}" MATCHES "${__regex}")
        list(APPEND __found "${CMAKE_MATCH_1}")
      endif()
    endforeach()
  endforeach()
  if(__found)
    list(REMOVE_DUPLICATES __found)
  endif()
  set(${outvar} "${__found}" PARENT_SCOPE)
endfunction()

# Which flags of ${flags} (list) are named in ${rejected} (list from ocv_probe_parse_rejected_flags)?
# A rejected entry ending with '=' matches a flag by prefix (GCC: "argument to '-Wfoo=' is not valid").
function(ocv_probe_match_rejected flags rejected outvar)
  set(__res "")
  foreach(__flag ${flags})
    set(__alt "")
    if(__flag MATCHES "^-Wno-(.+)$")
      set(__alt "-W${CMAKE_MATCH_1}=0")  # GCC reports -Wno-foo as '-Wfoo=0'
    endif()
    foreach(__r ${rejected})
      if(__flag STREQUAL __r OR (__alt AND __alt STREQUAL __r))
        list(APPEND __res "${__flag}")
      elseif(__r MATCHES "=$")
        string(LENGTH "${__r}" __len)
        string(SUBSTRING "${__flag}" 0 ${__len} __prefix)
        if(__prefix STREQUAL __r)
          list(APPEND __res "${__flag}")
        endif()
      endif()
    endforeach()
  endforeach()
  if(__res)
    list(REMOVE_DUPLICATES __res)
  endif()
  set(${outvar} "${__res}" PARENT_SCOPE)
endfunction()

# Reference check through the legacy try_compile() path (same call as in ocv_check_compiler_flag).
# Result: ${result} = 1/0 (normal variable), ${outvar} = build output.
# Cache variable name for a flag: the same mangling as ocv_check_flag_support().
function(ocv_probe_flag_varname lang flag outvar)
  string(TOUPPER "${flag}" __v)
  string(REGEX REPLACE "^(/|-)" "HAVE_${lang}_" __v "${__v}")
  string(REGEX REPLACE " -|-|=| |\\.|," "_" __v "${__v}")
  set(${outvar} "${__v}" PARENT_SCOPE)
endfunction()

# Can this single option token be checked together with others in one -fsyntax-only run?
function(ocv_probe_flag_is_batchable token outvar)
  if(token MATCHES "^-[A-Za-z]" AND NOT token MATCHES "^${OCV_PROBE_LINK_FLAGS_REGEX}"
      AND NOT token MATCHES "^${OCV_PROBE_CODEGEN_FLAGS_REGEX}"
      AND NOT token MATCHES "^${OCV_PROBE_UNBATCHABLE_FLAGS_REGEX}")
    set(${outvar} 1 PARENT_SCOPE)
  else()
    set(${outvar} 0 PARENT_SCOPE)
  endif()
endfunction()

# Lines of ${output} that look like a rejected option (OCV_COMPILER_FAIL_REGEX) but do not
# name one of the options in ${named} (list) -> ${outvar} (list of such lines).
function(ocv_probe_unattributed_failures output named outvar)
  set(__bad "")
  string(REPLACE ";" "," __lines "${output}")
  string(REPLACE "\n" ";" __lines "${__lines}")
  foreach(__line ${__lines})
    set(__is_fail 0)
    foreach(__regex ${OCV_COMPILER_FAIL_REGEX})
      if("${__line}" MATCHES "${__regex}")
        set(__is_fail 1)
        break()
      endif()
    endforeach()
    if(__is_fail)
      ocv_probe_parse_rejected_flags("${__line}" __names)
      ocv_probe_match_rejected("${named}" "${__names}" __m)
      if(NOT __m)
        list(APPEND __bad "${__line}")
      endif()
    endif()
  endforeach()
  set(${outvar} "${__bad}" PARENT_SCOPE)
endfunction()

# Probe several options with one -fsyntax-only run (re-run when the driver stops at an
# unknown option before the front end sees the rest). Every token that could be attributed
# gets OPENCV_PROBE_BATCH_<HAVE_var> = 1/0 (CACHE INTERNAL); the rest stay undefined and
# are probed individually later. Tokens whose HAVE_<LANG>_... variable already exists are skipped.
#   ocv_probe_flags_batch(<lang> <flag>...)   (a <flag> may hold several tokens)
function(ocv_probe_flags_batch lang)
  if(NOT OPENCV_FAST_PROBE_AVAILABLE_${lang})
    return()
  endif()
  if("${CMAKE_${lang}_FLAGS}" MATCHES "-Werror")
    return()  # individual checks use a different test source with -Werror, keep their semantics
  endif()
  set(__pending "")
  foreach(__flag ${ARGN})
    separate_arguments(__tokens NATIVE_COMMAND "${__flag}")
    foreach(__t ${__tokens})
      ocv_probe_flag_varname(${lang} "${__t}" __var)
      if(NOT DEFINED OPENCV_PROBE_BATCH_${__var} AND NOT DEFINED ${__var})
        ocv_probe_flag_is_batchable("${__t}" __ok)
        if(__ok)
          list(APPEND __pending "${__t}")
        endif()
      endif()
    endforeach()
  endforeach()
  if(NOT __pending)
    return()
  endif()
  list(REMOVE_DUPLICATES __pending)
  # GCC diagnoses a -Wfoo/-Wno-foo (or -Wfoo=N) pair only once, under the last spelling:
  # options sharing a stem go to separate runs.
  set(__ngroups 0)
  foreach(__t ${__pending})
    string(REGEX REPLACE "=.*$" "" __stem "${__t}")
    string(REGEX REPLACE "^-([Wf])no-" "-\\1" __stem "${__stem}")
    set(__placed 0)
    set(__g 1)
    while(NOT __placed AND __g LESS_EQUAL __ngroups)
      if(NOT "${__stem}" IN_LIST __stems_${__g})
        list(APPEND __group_${__g} "${__t}")
        list(APPEND __stems_${__g} "${__stem}")
        set(__placed 1)
      endif()
      math(EXPR __g "${__g} + 1")
    endwhile()
    if(NOT __placed)
      math(EXPR __ngroups "${__ngroups} + 1")
      set(__group_${__ngroups} "${__t}")
      set(__stems_${__ngroups} "${__stem}")
    endif()
  endforeach()
  set(__g 1)
  while(__g LESS_EQUAL __ngroups)
    __ocv_probe_flags_batch_run(${lang} "${__group_${__g}}")
    math(EXPR __g "${__g} + 1")
  endwhile()
endfunction()

# One batch: ${pending} is a list of single option tokens with distinct stems.
function(__ocv_probe_flags_batch_run lang pending)
  set(__pending "${pending}")
  list(LENGTH __pending __total)
  if(lang STREQUAL "C")
    set(__src "${OPENCV_PROBE_DIR}/flags_batch.c")
    file(WRITE "${__src}" "#pragma\nint main(void) { return 0; }\n")
  else()
    set(__src "${OPENCV_PROBE_DIR}/flags_batch.cxx")
    file(WRITE "${__src}" "#pragma\nint main() { return 0; }\n")
  endif()
  set(__rejected "")
  set(__accepted "")
  set(__runs 0)
  set(__ok 0)
  set(__why "")
  foreach(__pass 1 2 3 4)
    math(EXPR __runs "${__runs} + 1")
    ocv_probe_run(${lang} SYNTAX "${__src}" __rc __out FLAGS ${__pending})
    if("${__rc}" STREQUAL "NOTRUN")
      set(__why "probe not run")
      break()
    endif()
    ocv_probe_parse_rejected_flags("${__out}" __names)
    ocv_probe_match_rejected("${__pending}" "${__names}" __named)
    ocv_probe_unattributed_failures("${__out}" "${__named}" __bad)
    if(__bad)
      list(GET __bad 0 __why)
      set(__why "unattributed diagnostic: ${__why}")
      break()
    endif()
    if(__named)
      list(APPEND __rejected ${__named})
      list(REMOVE_ITEM __pending ${__named})
    endif()
    if(__rc EQUAL 0)
      set(__accepted "${__pending}")
      set(__ok 1)
      break()
    elseif(NOT __named)
      set(__why "compiler failed (rc=${__rc}) without naming an option")
      break()
    elseif(NOT __pending)
      set(__ok 1)
      break()
    endif()
    if(__pass EQUAL 4)
      set(__why "too many re-runs")
    endif()
  endforeach()
  if(NOT __ok)
    ocv_probe_log("# ${lang}: batched flag probe discarded: ${__why}")
    message(STATUS "OpenCV: ${lang}: batched flag probe discarded (${__why}), checking options individually")
    return()
  endif()
  foreach(__t ${__accepted})
    ocv_probe_flag_varname(${lang} "${__t}" __var)
    set(OPENCV_PROBE_BATCH_${__var} 1 CACHE INTERNAL "Batched probe: ${lang} ${__t} accepted")
    ocv_probe_record(OPENCV_PROBE_BATCH_${__var})
  endforeach()
  foreach(__t ${__rejected})
    ocv_probe_flag_varname(${lang} "${__t}" __var)
    set(OPENCV_PROBE_BATCH_${__var} 0 CACHE INTERNAL "Batched probe: ${lang} ${__t} rejected")
    ocv_probe_record(OPENCV_PROBE_BATCH_${__var})
  endforeach()
  get_property(__nb GLOBAL PROPERTY OCV_PROBE_BATCHED_FLAGS)
  if(NOT __nb)
    set(__nb 0)
  endif()
  math(EXPR __nb "${__nb} + ${__total}")
  set_property(GLOBAL PROPERTY OCV_PROBE_BATCHED_FLAGS ${__nb})
  list(LENGTH __rejected __nrej)
  string(REPLACE ";" " " __rej_str "${__rejected}")
  if(__nrej)
    set(__rej_str " (${__rej_str})")
  endif()
  message(STATUS "OpenCV: ${lang}: ${__total} compiler options probed in ${__runs} run(s), ${__nrej} rejected${__rej_str}")
endfunction()

# Batched probe of the known option list, once per language.
function(ocv_probe_prefill_known_flags lang)
  if(DEFINED OPENCV_PROBE_BATCH_PREFILLED_${lang})
    return()
  endif()
  set(OPENCV_PROBE_BATCH_PREFILLED_${lang} 1 CACHE INTERNAL "Known options were probed in a batch")
  ocv_probe_record(OPENCV_PROBE_BATCH_PREFILLED_${lang})
  ocv_probe_flags_batch(${lang} ${OPENCV_PROBE_KNOWN_FLAGS})
endfunction()

# Result of the batched probes for ${flag} (all of its tokens must have one):
# ${outvar} = 1 (every token accepted), 0 (some token rejected), "" (unknown).
function(ocv_probe_lookup_batch lang flag outvar)
  set(${outvar} "" PARENT_SCOPE)
  separate_arguments(__tokens NATIVE_COMMAND "${flag}")
  if(NOT __tokens)
    return()
  endif()
  set(__res 1)
  foreach(__t ${__tokens})
    ocv_probe_flag_varname(${lang} "${__t}" __var)
    if(NOT DEFINED OPENCV_PROBE_BATCH_${__var})
      return()
    endif()
    if(NOT OPENCV_PROBE_BATCH_${__var})
      set(__res 0)
    endif()
  endforeach()
  set(${outvar} ${__res} PARENT_SCOPE)
endfunction()

macro(__ocv_probe_legacy_try_compile LANG FLAG RESULT FNAME OUTVAR)
  if(CMAKE_REQUIRED_LIBRARIES)
    set(__link_libs LINK_LIBRARIES ${CMAKE_REQUIRED_LIBRARIES})
  else()
    set(__link_libs)
  endif()
  set(__cmake_flags "")
  if(CMAKE_EXE_LINKER_FLAGS)  # CMP0056 do this on new CMake
    list(APPEND __cmake_flags "-DCMAKE_EXE_LINKER_FLAGS=${CMAKE_EXE_LINKER_FLAGS}")
  endif()
  # CMP0067 do this on new CMake
  if(DEFINED CMAKE_CXX_STANDARD)
    list(APPEND __cmake_flags "-DCMAKE_CXX_STANDARD=${CMAKE_CXX_STANDARD}")
  endif()
  if(DEFINED CMAKE_CXX_STANDARD_REQUIRED)
    list(APPEND __cmake_flags "-DCMAKE_CXX_STANDARD_REQUIRED=${CMAKE_CXX_STANDARD_REQUIRED}")
  endif()
  if(DEFINED CMAKE_CXX_EXTENSIONS)
    list(APPEND __cmake_flags "-DCMAKE_CXX_EXTENSIONS=${CMAKE_CXX_EXTENSIONS}")
  endif()
  get_property(__ocv_tc_bypass_saved GLOBAL PROPERTY OCV_PROBE_TRY_COMPILE_BYPASS)
  set_property(GLOBAL PROPERTY OCV_PROBE_TRY_COMPILE_BYPASS 1)  # the real try_compile(), not the override
  TRY_COMPILE(${RESULT}
    "${CMAKE_BINARY_DIR}"
    "${FNAME}"
    CMAKE_FLAGS ${__cmake_flags}
    COMPILE_DEFINITIONS "${FLAG}"
    ${__link_libs}
    OUTPUT_VARIABLE ${OUTVAR})
  set_property(GLOBAL PROPERTY OCV_PROBE_TRY_COMPILE_BYPASS "${__ocv_tc_bypass_saved}")
endmacro()

# Self-test of the composed command line for one language. Sets ${reasonvar} on failure.
function(ocv_probe_selftest lang reasonvar)
  set(CMAKE_REQUIRED_LIBRARIES "")
  set(CMAKE_TRY_COMPILE_CONFIGURATION "${CMAKE_BUILD_TYPE}")
  if(lang STREQUAL "C")
    set(__src "${OPENCV_PROBE_DIR}/selftest.c")
    file(WRITE "${__src}" "int main(void) { return 0; }\n")
  else()
    set(__src "${OPENCV_PROBE_DIR}/selftest.cxx")
    file(WRITE "${__src}" "int main() { return 0; }\n")
  endif()
  # (a) trivial source
  ocv_probe_run(${lang} SYNTAX "${__src}" __rc __out)
  if(NOT __rc EQUAL 0)
    string(REGEX REPLACE "\n.*" "" __first "${__out}")
    set(${reasonvar} "trivial source does not compile with the composed command line (rc=${__rc}: ${__first})" PARENT_SCOPE)
    return()
  endif()
  # (b) known-good flag
  set(__good "-Wall")
  ocv_probe_run(${lang} SYNTAX "${__src}" __rc __out FLAGS "${__good}")
  ocv_probe_output_has_failure("${__out}" __fail)
  if(NOT __rc EQUAL 0 OR __fail)
    set(${reasonvar} "known-good flag ${__good} is rejected" PARENT_SCOPE)
    return()
  endif()
  # (c) two known-bad flags must be named in the diagnostics (possibly over two runs: the
  #     driver may stop at an unknown -f option before the front end reports the -W one)
  set(__bad_w "-Wopencv-probe-no-such-warning")
  set(__bad_f "-fopencv-probe-no-such-option")
  set(__pending "${__bad_w};${__bad_f}")
  foreach(__pass 1 2 3)
    if(NOT __pending)
      break()
    endif()
    ocv_probe_run(${lang} SYNTAX "${__src}" __rc __out FLAGS "${__pending}")
    ocv_probe_parse_rejected_flags("${__out}" __rejected)
    ocv_probe_match_rejected("${__pending}" "${__rejected}" __named)
    if(NOT __named)
      break()
    endif()
    list(REMOVE_ITEM __pending ${__named})
  endforeach()
  if(__pending)
    set(${reasonvar} "cannot attribute diagnostics to unsupported flags (${__pending})" PARENT_SCOPE)
    return()
  endif()
  # (d) agreement with the legacy try_compile() path
  ocv_probe_run(${lang} SYNTAX "${__src}" __rc __out FLAGS "${__bad_w}")
  ocv_probe_output_has_failure("${__out}" __fail)
  if(__rc EQUAL 0 AND NOT __fail)
    set(__direct_bad 1)
  else()
    set(__direct_bad 0)
  endif()
  __ocv_probe_legacy_try_compile(${lang} "${__good}" OPENCV_PROBE_REF_GOOD_${lang} "${__src}" __ref_out)
  ocv_probe_output_has_failure("${__ref_out}" __fail)
  if(OPENCV_PROBE_REF_GOOD_${lang} AND NOT __fail)
    set(__ref_good 1)
  else()
    set(__ref_good 0)
  endif()
  __ocv_probe_legacy_try_compile(${lang} "${__bad_w}" OPENCV_PROBE_REF_BAD_${lang} "${__src}" __ref_out)
  ocv_probe_output_has_failure("${__ref_out}" __fail)
  if(OPENCV_PROBE_REF_BAD_${lang} AND NOT __fail)
    set(__ref_bad 1)
  else()
    set(__ref_bad 0)
  endif()
  ocv_probe_record(OPENCV_PROBE_REF_GOOD_${lang})
  ocv_probe_record(OPENCV_PROBE_REF_BAD_${lang})
  if(NOT __ref_good EQUAL 1 OR NOT __direct_bad EQUAL __ref_bad)
    set(${reasonvar} "direct results (good=1 bad=${__direct_bad}) differ from try_compile() results (good=${__ref_good} bad=${__ref_bad})" PARENT_SCOPE)
    return()
  endif()
  # (f) link line: the trivial program must link directly, otherwise only link-level
  #     probes (CMAKE_REQUIRED_LIBRARIES, -pthread, check_function_exists, ...) keep
  #     using try_compile(); compile-only probes stay direct
  set(OPENCV_FAST_PROBE_LINK_${lang} 0 CACHE INTERNAL "Direct link line usable for ${lang} probes")
  ocv_probe_record(OPENCV_FAST_PROBE_LINK_${lang})
  set(__link_reason "")
  if(CMAKE_SYSROOT_LINK AND NOT "${CMAKE_SYSROOT_LINK}" STREQUAL "${CMAKE_SYSROOT_COMPILE}")
    set(__link_reason "CMAKE_SYSROOT_LINK differs from CMAKE_SYSROOT_COMPILE")
  elseif(NOT CMAKE_TRY_COMPILE_TARGET_TYPE STREQUAL "STATIC_LIBRARY")
    ocv_probe_run(${lang} LINK "${__src}" __rc __out)
    if(NOT __rc EQUAL 0)
      string(REGEX REPLACE "\n.*" "" __first "${__out}")
      set(__link_reason "trivial program does not link with the composed command line (rc=${__rc}: ${__first})")
    endif()
  endif()
  if(__link_reason)
    message(STATUS "OpenCV: fast compiler probes (${lang}): link-level checks use try_compile() - ${__link_reason}")
    ocv_probe_log("# ${lang}: direct link line not usable - ${__link_reason}")
  else()
    set(OPENCV_FAST_PROBE_LINK_${lang} 1 CACHE INTERNAL "Direct link line usable for ${lang} probes")
  endif()
  # (e) preprocessor: pointer size must agree with CMake's ABI detection
  #     (not possible with several -arch options: clang cannot preprocess for multiple
  #     architectures at once; type sizes are not probed in that case either)
  list(LENGTH CMAKE_OSX_ARCHITECTURES __narch)
  if(__narch GREATER 1)
    return()
  endif()
  set(__pp "${OPENCV_PROBE_DIR}/selftest_pp.c")
  file(WRITE "${__pp}" "@@OCV_PROBE_OK=1\n#ifdef __SIZEOF_POINTER__\n@@SIZEOF_POINTER=__SIZEOF_POINTER__\n#endif\n")
  ocv_probe_run(${lang} PREPROCESS "${__pp}" __rc __out)
  if(NOT __rc EQUAL 0 OR NOT "${__out}" MATCHES "@@OCV_PROBE_OK=1")
    set(${reasonvar} "preprocessor probe failed (rc=${__rc})" PARENT_SCOPE)
    return()
  endif()
  if("${__out}" MATCHES "@@SIZEOF_POINTER=([0-9]+)" AND CMAKE_SIZEOF_VOID_P)
    if(NOT "${CMAKE_MATCH_1}" STREQUAL "${CMAKE_SIZEOF_VOID_P}")
      set(${reasonvar} "preprocessor reports sizeof(void*)=${CMAKE_MATCH_1}, CMake detected ${CMAKE_SIZEOF_VOID_P} (wrong target/sysroot?)" PARENT_SCOPE)
      return()
    endif()
  endif()
endfunction()

# Decide once per language whether the fast path can be used.
# Result: OPENCV_FAST_PROBE_AVAILABLE_<lang> (1/0) and OPENCV_FAST_PROBE_REASON_<lang> in the cache.
function(ocv_probe_init lang)
  ocv_probe_check_cache_key()
  if(DEFINED OPENCV_FAST_PROBE_AVAILABLE_${lang})
    return()
  endif()
  set(__reason "")
  ocv_check_environment_variables(OPENCV_SKIP_FAST_COMPILER_PROBES)
  if((DEFINED OPENCV_FAST_COMPILER_PROBES AND NOT OPENCV_FAST_COMPILER_PROBES) OR OPENCV_SKIP_FAST_COMPILER_PROBES)
    set(__reason "disabled by OPENCV_FAST_COMPILER_PROBES=OFF")
  elseif(CMAKE_GENERATOR MATCHES "Visual Studio")
    set(__reason "Visual Studio generator (compiler environment is set up by MSBuild)")
  elseif(NOT CMAKE_${lang}_COMPILER OR NOT DEFINED CMAKE_${lang}_COMPILER_ID)
    set(__reason "${lang} compiler is not enabled")
  elseif(CMAKE_${lang}_COMPILER_ID STREQUAL "MSVC" OR CMAKE_${lang}_SIMULATE_ID STREQUAL "MSVC" OR MSVC)
    set(__reason "MSVC-style command line is not supported yet")
  elseif(NOT CMAKE_${lang}_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang|IntelLLVM)$")
    set(__reason "unsupported compiler ${CMAKE_${lang}_COMPILER_ID}")
  elseif(NOT EXISTS "${CMAKE_${lang}_COMPILER}")
    set(__reason "compiler '${CMAKE_${lang}_COMPILER}' is not a file")
  endif()
  if(NOT __reason)
    ocv_probe_compiler_base_command(${lang} __base __reason)
  endif()
  if(NOT __reason)
    set(OPENCV_PROBE_BASE_COMMAND_${lang} "${__base}" CACHE INTERNAL "Compiler command prefix for fast probes")
    ocv_probe_selftest(${lang} __reason)
  endif()
  if(__reason)
    set(OPENCV_FAST_PROBE_AVAILABLE_${lang} 0 CACHE INTERNAL "Fast compiler probes (${lang}) usable")
    set(OPENCV_FAST_PROBE_REASON_${lang} "${__reason}" CACHE INTERNAL "")
    unset(OPENCV_PROBE_BASE_COMMAND_${lang} CACHE)
    message(STATUS "OpenCV: fast compiler probes (${lang}): disabled - ${__reason}")
    ocv_probe_log("# ${lang}: fast probes disabled - ${__reason}")
  else()
    set(OPENCV_FAST_PROBE_AVAILABLE_${lang} 1 CACHE INTERNAL "Fast compiler probes (${lang}) usable")
    set(OPENCV_FAST_PROBE_REASON_${lang} "" CACHE INTERNAL "")
    message(STATUS "OpenCV: fast compiler probes (${lang}): enabled (${CMAKE_${lang}_COMPILER_ID} ${CMAKE_${lang}_COMPILER_VERSION})")
  endif()
endfunction()

# Choose how ocv_check_compiler_flag() should run a probe.
# ${outvar}: SYNTAX / OBJECT / LINK for the direct path, "" for the legacy try_compile() path.
# ${langvar}: normalized language (C / CXX).
function(ocv_probe_select_mode LANG FLAG SRC RESULT outvar langvar)
  set(${outvar} "" PARENT_SCOPE)
  if("x${LANG}" STREQUAL "xCXX")
    set(__lang CXX)
  elseif("x${LANG}" STREQUAL "xC")
    set(__lang C)
  else()
    set(${langvar} "${LANG}" PARENT_SCOPE)
    return()  # OBJCXX and anything else: legacy
  endif()
  set(${langvar} "${__lang}" PARENT_SCOPE)
  ocv_probe_init(${__lang})
  if(NOT OPENCV_FAST_PROBE_AVAILABLE_${__lang})
    return()
  endif()
  set(__mode SYNTAX)
  if(CMAKE_REQUIRED_LIBRARIES OR RESULT MATCHES "^HAVE_LINK_"
      OR " ${FLAG} " MATCHES " ${OCV_PROBE_LINK_FLAGS_REGEX}")
    set(__mode LINK)
  elseif(SRC MATCHES "/cmake/checks/" OR " ${FLAG} " MATCHES " ${OCV_PROBE_CODEGEN_FLAGS_REGEX}")
    set(__mode OBJECT)  # custom sources (SIMD intrinsics etc.) need code generation, -fsyntax-only is not enough
  endif()
  if(__mode STREQUAL "LINK")
    if(CMAKE_TRY_COMPILE_TARGET_TYPE STREQUAL "STATIC_LIBRARY")
      set(__mode OBJECT)  # try_compile() does not link in this mode either
    elseif(NOT OPENCV_FAST_PROBE_LINK_${__lang})
      return()  # the direct link line failed the self-test (see ocv_probe_selftest): legacy
    endif()
  endif()
  set(${outvar} "${__mode}" PARENT_SCOPE)
endfunction()

# Direct replacement for a try_compile() of one source with include/link settings
# (the LAPACK and similar library checks).
#   ocv_probe_try_link(<lang> <src> <result-var> <output-var>
#                      [FLAGS ...] [INCLUDE_DIRS ...] [LINK_DIRS ...] [LINK_LIBRARIES ...])
# <result-var>: 1 / 0, or "" when the direct path is not applicable (then run try_compile()).
function(ocv_probe_try_link lang src resultvar outvar)
  set(${resultvar} "" PARENT_SCOPE)
  set(${outvar} "" PARENT_SCOPE)
  ocv_probe_init(${lang})
  if(NOT OPENCV_FAST_PROBE_AVAILABLE_${lang})
    return()
  endif()
  set(__mode LINK)
  if(CMAKE_TRY_COMPILE_TARGET_TYPE STREQUAL "STATIC_LIBRARY")
    set(__mode OBJECT)  # try_compile() does not link in this mode either
  elseif(NOT OPENCV_FAST_PROBE_LINK_${lang})
    return()
  endif()
  ocv_probe_run(${lang} ${__mode} "${src}" __rc __out ${ARGN})
  if("${__rc}" STREQUAL "NOTRUN")
    return()
  endif()
  if(__rc EQUAL 0)
    set(${resultvar} 1 PARENT_SCOPE)
  else()
    set(${resultvar} 0 PARENT_SCOPE)
  endif()
  set(${outvar} "${__out}" PARENT_SCOPE)
endfunction()

# check_include_file() with the header compiled directly (same semantics: the header must
# compile with the C compiler); falls back to the CMake module when the direct path is not
# available or CMAKE_REQUIRED_* settings are in effect.
function(ocv_probe_check_include_file name var)
  if(DEFINED ${var})
    return()
  endif()
  ocv_probe_init(C)
  set(__done 0)
  if(OPENCV_FAST_PROBE_AVAILABLE_C AND NOT CMAKE_REQUIRED_FLAGS AND NOT CMAKE_REQUIRED_DEFINITIONS
      AND NOT CMAKE_REQUIRED_INCLUDES AND NOT CMAKE_REQUIRED_LIBRARIES AND NOT CMAKE_REQUIRED_LINK_OPTIONS)
    string(MAKE_C_IDENTIFIER "${name}" __id)
    set(__src "${OPENCV_PROBE_DIR}/include_${__id}.c")
    file(WRITE "${__src}" "#include <${name}>\n\nint main(void) { return 0; }\n")
    if(NOT CMAKE_REQUIRED_QUIET)
      message(STATUS "Looking for ${name}")
    endif()
    ocv_probe_run(C SYNTAX "${__src}" __rc __out)
    if(NOT "${__rc}" STREQUAL "NOTRUN")
      set(__done 1)
      if(__rc EQUAL 0)
        set(${var} 1 CACHE INTERNAL "Have include ${name}")
        set(__msg "found")
      else()
        set(${var} "" CACHE INTERNAL "Have include ${name}")
        set(__msg "not found")
      endif()
      if(NOT CMAKE_REQUIRED_QUIET)
        message(STATUS "Looking for ${name} - ${__msg}")
      endif()
      ocv_probe_record(${var})
      if(OPENCV_VERIFY_FAST_PROBES)
        include(CheckIncludeFile)
        set(CMAKE_REQUIRED_QUIET 1)
        unset(OCV_VERIFY_${var} CACHE)
        check_include_file("${name}" OCV_VERIFY_${var})
        if(${var})
          set(__direct 1)
        else()
          set(__direct 0)
        endif()
        if(OCV_VERIFY_${var})
          set(__legacy 1)
        else()
          set(__legacy 0)
        endif()
        if(NOT __direct EQUAL __legacy)
          ocv_probe_report_mismatch("${var} (include ${name})" ${__direct} ${__legacy})
        endif()
        unset(OCV_VERIFY_${var} CACHE)
      endif()
    endif()
  endif()
  if(NOT __done)
    include(CheckIncludeFile)
    check_include_file("${name}" ${var})
  endif()
endfunction()

function(ocv_probe_report_mismatch what direct legacy)
  set(__msg "fast probe mismatch: ${what}: direct=${direct} try_compile=${legacy}")
  ocv_probe_log("# ${__msg}")
  get_property(__list GLOBAL PROPERTY OCV_PROBE_MISMATCHES)
  list(APPEND __list "${what}")
  set_property(GLOBAL PROPERTY OCV_PROBE_MISMATCHES "${__list}")
  if("${OPENCV_VERIFY_FAST_PROBES}" STREQUAL "STRICT")
    message(FATAL_ERROR "${__msg}")
  else()
    message(WARNING "${__msg}")
  endif()
endfunction()

# Summary for the configuration status dump.
function(ocv_probe_status_summary outvar)
  set(__s "")
  foreach(lang C CXX)
    if(DEFINED OPENCV_FAST_PROBE_AVAILABLE_${lang})
      if(OPENCV_FAST_PROBE_AVAILABLE_${lang})
        list(APPEND __s "${lang}: direct")
      else()
        list(APPEND __s "${lang}: try_compile (${OPENCV_FAST_PROBE_REASON_${lang}})")
      endif()
    endif()
  endforeach()
  get_property(__n GLOBAL PROPERTY OCV_PROBE_COUNTER)
  if(__n)
    list(APPEND __s "${__n} direct compiler runs")
  endif()
  get_property(__nb GLOBAL PROPERTY OCV_PROBE_BATCHED_FLAGS)
  if(__nb)
    list(APPEND __s "${__nb} options batched")
  endif()
  get_property(__ni GLOBAL PROPERTY OCV_PROBE_TC_INTERCEPTED)
  get_property(__nf GLOBAL PROPERTY OCV_PROBE_TC_FORWARDED)
  if(__ni OR __nf)
    if(NOT __ni)
      set(__ni 0)
    endif()
    if(NOT __nf)
      set(__nf 0)
    endif()
    list(APPEND __s "try_compile(): ${__ni} direct, ${__nf} passed through")
  endif()
  if(OPENCV_VERIFY_FAST_PROBES)
    get_property(__m GLOBAL PROPERTY OCV_PROBE_MISMATCHES)
    list(LENGTH __m __mn)
    list(APPEND __s "verify: ${__mn} mismatches")
  endif()
  string(REPLACE ";" ", " __s "${__s}")
  set(${outvar} "${__s}" PARENT_SCOPE)
endfunction()

# ----------------------------------------------------------------------------
# try_compile() interception
# ----------------------------------------------------------------------------
# Keywords of both try_compile() signatures (CMake 3.13 ... 4.x).
set(OCV_TC_KEYWORDS SOURCES SOURCE_FROM_CONTENT SOURCE_FROM_VAR SOURCE_FROM_FILE SOURCES_TYPE
    CMAKE_FLAGS COMPILE_DEFINITIONS LINK_OPTIONS LINK_LIBRARIES OUTPUT_VARIABLE
    COPY_FILE COPY_FILE_ERROR LOG_DESCRIPTION NO_CACHE NO_LOG
    PROJECT SOURCE_DIR BINARY_DIR TARGET)
# Sources of CMake modules whose outcome does not depend on linking: declaration/type tests.
set(OCV_TC_COMPILE_ONLY_SOURCES_REGEX "(^|/)(CheckIncludeFile|CheckIncludeFiles|CheckSymbolExists)\\.(c|cxx|cpp)$")

# try_compile() stores its result with set(CACHE INTERNAL), which under policy CMP0126 OLD
# (CMake < 3.21 behaviour, OpenCV's minimum is 3.13) also removes a normal variable of the
# same name in the calling scope. The override runs the builtin in its own function scope,
# so the caller's scope has to get the same treatment, otherwise a stale normal variable
# (e.g. one set from a previous check's result) would shadow the fresh cache entry.
macro(__ocv_tc_cache_set_effect __ocv_tc_var)
  set(__ocv_tc_policy "OLD")
  if(POLICY CMP0126)
    cmake_policy(GET CMP0126 __ocv_tc_policy)
  endif()
  if(NOT __ocv_tc_policy STREQUAL "NEW")
    unset(${__ocv_tc_var} PARENT_SCOPE)
  endif()
endmacro()

# Installs the try_compile() override. Called once from the root CMakeLists.txt after the
# compilers are known; everything before that (compiler id, ABI detection) is untouched.
function(ocv_probe_enable_try_compile_interception)
  if(COMMAND _try_compile)
    message(STATUS "OpenCV: try_compile() is already overridden, OPENCV_FAST_TRY_COMPILE has no effect")
    return()
  endif()
  function(try_compile __ocv_tc_result)
    __ocv_tc_call("${__ocv_tc_result}" ${ARGC})
  endfunction()
  # __ocv_tc_call() is a macro, so that ARGV<i> of the override and the caller's variables
  # (SOURCE_FROM_VAR, CMAKE_REQUIRED_*) are visible to it, and PARENT_SCOPE reaches the caller.
  macro(__ocv_tc_call __ocv_tc_result __ocv_tc_argc)
    # 1. parse the arguments (ARGV<i> keeps embedded ';', unlike ARGN)
    set(__tc_reason "")
    set(__tc_fwd "")              # the original arguments, ';' escaped, for _try_compile()
    set(__tc_positional "")
    set(__tc_srcs "")
    set(__tc_cmake_defs "")       # -DCOMPILE_DEFINITIONS=<flags string>
    set(__tc_defs "")             # COMPILE_DEFINITIONS keyword
    set(__tc_incs "")
    set(__tc_linkdirs "")
    set(__tc_libs "")
    set(__tc_lopts "")
    set(__tc_outvar "")
    set(__tc_copy "")
    set(__tc_copy_err "")
    set(__tc_nocache 0)
    set(__tc_overrides "")        # names of CMAKE_* variables overridden for this call
    set(__tc_kw "")
    set(__tc_nleft 0)
    set(__tc_name "")
    get_property(__tc_n GLOBAL PROPERTY OCV_PROBE_TC_COUNTER)
    if(NOT __tc_n)
      set(__tc_n 0)
    endif()
    math(EXPR __tc_n "${__tc_n} + 1")
    set_property(GLOBAL PROPERTY OCV_PROBE_TC_COUNTER ${__tc_n})
    set(__tc_dir "${OPENCV_PROBE_DIR}/tc/${__tc_n}")
    if(${__ocv_tc_argc} GREATER 1)
      math(EXPR __tc_last "${__ocv_tc_argc} - 1")
      foreach(__tc_i RANGE 1 ${__tc_last})
        set(__tc_a "${ARGV${__tc_i}}")
        string(REPLACE ";" "\;" __tc_esc "${__tc_a}")
        list(APPEND __tc_fwd "${__tc_esc}")
        if("${__tc_a}" IN_LIST OCV_TC_KEYWORDS OR "${__tc_a}" MATCHES "^[A-Z]+_(STANDARD|STANDARD_REQUIRED|EXTENSIONS)$")
          set(__tc_kw "${__tc_a}")
          set(__tc_nleft -1)
          if(__tc_kw STREQUAL "NO_CACHE")
            set(__tc_nocache 1)
            set(__tc_kw "")
          elseif(__tc_kw STREQUAL "NO_LOG")
            set(__tc_kw "")
          elseif(__tc_kw MATCHES "^(PROJECT|SOURCE_DIR|BINARY_DIR|TARGET)$")
            set(__tc_reason "project signature")
            set(__tc_kw "")
          elseif(__tc_kw MATCHES "^SOURCE_FROM_")
            set(__tc_nleft 2)
          elseif(__tc_kw MATCHES "^(SOURCES_TYPE|OUTPUT_VARIABLE|COPY_FILE|COPY_FILE_ERROR|LOG_DESCRIPTION|[A-Z]+_(STANDARD|STANDARD_REQUIRED|EXTENSIONS))$")
            set(__tc_nleft 1)
          endif()
          continue()
        endif()
        if(NOT __tc_kw)
          list(APPEND __tc_positional "${__tc_a}")
        elseif(__tc_kw STREQUAL "SOURCES")
          list(APPEND __tc_srcs "${__tc_a}")
        elseif(__tc_kw MATCHES "^SOURCE_FROM_")
          if(__tc_nleft EQUAL 2)
            get_filename_component(__tc_name "${__tc_a}" NAME)
          elseif(__tc_kw STREQUAL "SOURCE_FROM_FILE")
            list(APPEND __tc_srcs "${__tc_a}")
          else()
            file(MAKE_DIRECTORY "${__tc_dir}")
            if(__tc_kw STREQUAL "SOURCE_FROM_VAR")
              file(WRITE "${__tc_dir}/${__tc_name}" "${${__tc_a}}")
            else()
              file(WRITE "${__tc_dir}/${__tc_name}" "${__tc_a}")
            endif()
            list(APPEND __tc_srcs "${__tc_dir}/${__tc_name}")
          endif()
        elseif(__tc_kw STREQUAL "CMAKE_FLAGS")
          if("${__tc_a}" STREQUAL "")
            # empty entries are common: "${_CIF_INCLUDE_DIRECTORIES}" with no CMAKE_REQUIRED_INCLUDES
          elseif("${__tc_a}" MATCHES "^-D([A-Za-z_0-9]+)(:[A-Z]+)?=(.*)$")
            set(__tc_fname "${CMAKE_MATCH_1}")
            set(__tc_fval "${CMAKE_MATCH_3}")
            if(__tc_fname STREQUAL "COMPILE_DEFINITIONS")
              string(APPEND __tc_cmake_defs " ${__tc_fval}")
            elseif(__tc_fname STREQUAL "INCLUDE_DIRECTORIES")
              list(APPEND __tc_incs ${__tc_fval})
            elseif(__tc_fname STREQUAL "LINK_DIRECTORIES")
              list(APPEND __tc_linkdirs ${__tc_fval})
            elseif(__tc_fname STREQUAL "LINK_LIBRARIES")
              list(APPEND __tc_libs ${__tc_fval})
            elseif(__tc_fname MATCHES "^CMAKE_((C|CXX)_(FLAGS|STANDARD|STANDARD_REQUIRED|EXTENSIONS)|EXE_LINKER_FLAGS|TRY_COMPILE_CONFIGURATION)$")
              set(__tc_override_${__tc_fname} "${__tc_fval}")
              list(APPEND __tc_overrides "${__tc_fname}")
            elseif(__tc_fname MATCHES "^CMAKE_(SKIP_RPATH|SKIP_BUILD_RPATH|VERBOSE_MAKEFILE)$")
              # no influence on the outcome
            else()
              set(__tc_reason "CMAKE_FLAGS entry '${__tc_a}'")
            endif()
          else()
            set(__tc_reason "CMAKE_FLAGS entry '${__tc_a}'")
          endif()
        elseif(__tc_kw STREQUAL "COMPILE_DEFINITIONS")
          list(APPEND __tc_defs "${__tc_a}")
        elseif(__tc_kw STREQUAL "LINK_OPTIONS")
          if("${__tc_a}" MATCHES "^(LINKER|SHELL):")
            set(__tc_reason "LINK_OPTIONS entry '${__tc_a}'")
          else()
            list(APPEND __tc_lopts "${__tc_a}")
          endif()
        elseif(__tc_kw STREQUAL "LINK_LIBRARIES")
          list(APPEND __tc_libs "${__tc_a}")
        elseif(__tc_kw STREQUAL "OUTPUT_VARIABLE")
          set(__tc_outvar "${__tc_a}")
        elseif(__tc_kw STREQUAL "COPY_FILE")
          set(__tc_copy "${__tc_a}")
        elseif(__tc_kw STREQUAL "COPY_FILE_ERROR")
          set(__tc_copy_err "${__tc_a}")
        elseif(__tc_kw STREQUAL "SOURCES_TYPE")
          if(NOT "${__tc_a}" STREQUAL "NORMAL")
            set(__tc_reason "SOURCES_TYPE ${__tc_a}")
          endif()
        elseif(__tc_kw STREQUAL "LOG_DESCRIPTION")
          # informational only
        elseif(__tc_kw MATCHES "^(C|CXX)_(STANDARD|STANDARD_REQUIRED|EXTENSIONS)$")
          set(__tc_override_CMAKE_${__tc_kw} "${__tc_a}")
          list(APPEND __tc_overrides "CMAKE_${__tc_kw}")
        else()
          set(__tc_reason "${__tc_kw} ${__tc_a}")  # <OTHERLANG>_STANDARD etc.
        endif()
        if(__tc_nleft GREATER 0)
          math(EXPR __tc_nleft "${__tc_nleft} - 1")
          if(__tc_nleft EQUAL 0)
            set(__tc_kw "")
          endif()
        endif()
      endforeach()
    endif()
    # old signature: <bindir> <srcfile>... ; project signature: <bindir> <srcdir> <projectName>
    list(LENGTH __tc_positional __tc_npos)
    if(__tc_npos GREATER 1)
      list(REMOVE_AT __tc_positional 0)
      foreach(__tc_a ${__tc_positional})
        if(IS_DIRECTORY "${__tc_a}")
          set(__tc_reason "project signature")
        endif()
        list(APPEND __tc_srcs "${__tc_a}")
      endforeach()
    endif()
    # 2. language, mode
    set(__tc_lang "")
    foreach(__tc_a ${__tc_srcs})
      if("${__tc_a}" MATCHES "\\.c$")
        set(__tc_l C)
      elseif("${__tc_a}" MATCHES "\\.(cpp|cxx|cc|C|c\\+\\+)$")
        set(__tc_l CXX)
      else()
        set(__tc_l "")
        set(__tc_reason "source '${__tc_a}'")
      endif()
      if(__tc_lang AND __tc_l AND NOT __tc_lang STREQUAL __tc_l)
        set(__tc_reason "sources of several languages")
      endif()
      set(__tc_lang "${__tc_l}")
    endforeach()
    if(NOT __tc_srcs AND NOT __tc_reason)
      set(__tc_reason "no sources")
    endif()
    foreach(__tc_a ${__tc_libs} ${__tc_defs} ${__tc_incs})
      if("${__tc_a}" MATCHES "\\$<")
        set(__tc_reason "generator expression '${__tc_a}'")
      endif()
    endforeach()
    get_property(__tc_bypass GLOBAL PROPERTY OCV_PROBE_TRY_COMPILE_BYPASS)
    if(__tc_bypass)
      set(__tc_reason "explicit try_compile() request")
    endif()
    if(NOT __tc_reason)
      ocv_probe_init(${__tc_lang})
      if(NOT OPENCV_FAST_PROBE_AVAILABLE_${__tc_lang})
        set(__tc_reason "fast probes unavailable for ${__tc_lang}")
      endif()
    endif()
    set(__tc_mode "")
    if(NOT __tc_reason)
      set(__tc_mode OBJECT)
      set(__tc_link 1)
      set(__tc_src_names "")
      foreach(__tc_a ${__tc_srcs})
        get_filename_component(__tc_b "${__tc_a}" NAME)
        list(APPEND __tc_src_names "${__tc_b}")
      endforeach()
      if(__tc_copy)
        set(__tc_link 0)  # CheckTypeSize: the INFO:size strings are read from the object file
      elseif("${__tc_src_names}" MATCHES "${OCV_TC_COMPILE_ONLY_SOURCES_REGEX}")
        set(__tc_link 0)
      endif()
      set(__tc_flags "${CMAKE_${__tc_lang}_FLAGS}")
      if(DEFINED __tc_override_CMAKE_${__tc_lang}_FLAGS)
        set(__tc_flags "${__tc_override_CMAKE_${__tc_lang}_FLAGS}")
      endif()
      if(__tc_libs OR __tc_lopts OR __tc_linkdirs OR DEFINED __tc_override_CMAKE_EXE_LINKER_FLAGS
          OR " ${__tc_cmake_defs} ${__tc_defs} ${__tc_flags} " MATCHES " ${OCV_PROBE_LINK_FLAGS_REGEX}")
        set(__tc_link 1)
      endif()
      if(__tc_link)
        if(CMAKE_TRY_COMPILE_TARGET_TYPE STREQUAL "STATIC_LIBRARY")
          set(__tc_mode OBJECT)  # try_compile() does not link either
        elseif(NOT OPENCV_FAST_PROBE_LINK_${__tc_lang})
          set(__tc_reason "link-level check, direct link line unavailable")
        else()
          set(__tc_mode LINK)
        endif()
      endif()
    endif()
    # 3. run
    set(__tc_res "")
    set(__tc_out "")
    if(NOT __tc_reason)
      foreach(__tc_v ${__tc_overrides})
        set(${__tc_v} "${__tc_override_${__tc_v}}")  # seen by ocv_probe_run() (dynamic scope)
      endforeach()
      set(__tc_pflags "")
      string(STRIP "${__tc_cmake_defs}" __tc_cmake_defs)
      if(__tc_cmake_defs)
        list(APPEND __tc_pflags "${__tc_cmake_defs}")
      endif()
      list(APPEND __tc_pflags ${__tc_defs})
      set(__tc_rc 0)
      if(__tc_mode STREQUAL "LINK")
        ocv_probe_run(${__tc_lang} LINK "${__tc_srcs}" __tc_rc __tc_out
                      FLAGS ${__tc_pflags} INCLUDE_DIRS ${__tc_incs}
                      LINK_DIRS ${__tc_linkdirs} LINK_LIBRARIES ${__tc_libs} ${__tc_lopts})
      else()
        foreach(__tc_a ${__tc_srcs})
          ocv_probe_run(${__tc_lang} OBJECT "${__tc_a}" __tc_rc __tc_o FLAGS ${__tc_pflags} INCLUDE_DIRS ${__tc_incs})
          string(APPEND __tc_out "${__tc_o}")
          if(NOT __tc_rc EQUAL 0)
            break()
          endif()
        endforeach()
      endif()
      if("${__tc_rc}" STREQUAL "NOTRUN")
        set(__tc_reason "command line cannot be composed")
      elseif(__tc_rc EQUAL 0)
        set(__tc_res TRUE)
      else()
        set(__tc_res FALSE)
      endif()
    endif()
    # 4. results, or pass-through
    if(__tc_reason)
      get_property(__tc_nf GLOBAL PROPERTY OCV_PROBE_TC_FORWARDED)
      if(NOT __tc_nf)
        set(__tc_nf 0)
      endif()
      math(EXPR __tc_nf "${__tc_nf} + 1")
      set_property(GLOBAL PROPERTY OCV_PROBE_TC_FORWARDED ${__tc_nf})
      if(NOT __tc_bypass)
        ocv_probe_log("# try_compile(${__ocv_tc_result}) passed through: ${__tc_reason}")
      endif()
      _try_compile(${__ocv_tc_result} ${__tc_fwd})
      # a macro runs in the override's scope: forward what the builtin set there
      if(__tc_nocache)
        set(${__ocv_tc_result} "${${__ocv_tc_result}}" PARENT_SCOPE)
      else()
        __ocv_tc_cache_set_effect(${__ocv_tc_result})
      endif()
      if(__tc_outvar)
        set(${__tc_outvar} "${${__tc_outvar}}" PARENT_SCOPE)
      endif()
      if(__tc_copy_err)
        set(${__tc_copy_err} "${${__tc_copy_err}}" PARENT_SCOPE)
      endif()
    else()
      get_property(__tc_ni GLOBAL PROPERTY OCV_PROBE_TC_INTERCEPTED)
      if(NOT __tc_ni)
        set(__tc_ni 0)
      endif()
      math(EXPR __tc_ni "${__tc_ni} + 1")
      set_property(GLOBAL PROPERTY OCV_PROBE_TC_INTERCEPTED ${__tc_ni})
      ocv_probe_log("# try_compile(${__ocv_tc_result}): ${__tc_lang} ${__tc_mode} ${__tc_src_names} -> ${__tc_res}")
      if(__tc_copy)
        get_property(__tc_pn GLOBAL PROPERTY OCV_PROBE_COUNTER)
        if(__tc_mode STREQUAL "LINK")
          set(__tc_bin "${OPENCV_PROBE_DIR}/probe_${__tc_pn}.exe")
        else()
          set(__tc_bin "${OPENCV_PROBE_DIR}/probe_${__tc_pn}.o")
        endif()
        if(__tc_res AND EXISTS "${__tc_bin}")
          configure_file("${__tc_bin}" "${__tc_copy}" COPYONLY)
        endif()
        if(__tc_copy_err)
          set(${__tc_copy_err} "" PARENT_SCOPE)
        endif()
      endif()
      if(__tc_nocache)
        set(${__ocv_tc_result} ${__tc_res} PARENT_SCOPE)
      else()
        set(${__ocv_tc_result} ${__tc_res} CACHE INTERNAL "Result of TRY_COMPILE")
        __ocv_tc_cache_set_effect(${__ocv_tc_result})
      endif()
      if(__tc_outvar)
        set(${__tc_outvar} "${__tc_out}" PARENT_SCOPE)
      endif()
      if(OPENCV_VERIFY_FAST_PROBES)
        unset(__ocv_tc_ref)
        unset(__ocv_tc_ref CACHE)
        _try_compile(__ocv_tc_ref ${__tc_fwd})
        if(__ocv_tc_ref)
          set(__tc_ref TRUE)
        else()
          set(__tc_ref FALSE)
        endif()
        if(NOT __tc_ref STREQUAL __tc_res)
          ocv_probe_report_mismatch("try_compile(${__ocv_tc_result}) (${__tc_lang} ${__tc_mode} ${__tc_src_names})" "${__tc_res}" "${__tc_ref}")
        endif()
        unset(__ocv_tc_ref)
        unset(__ocv_tc_ref CACHE)
      endif()
    endif()
  endmacro()
endfunction()
